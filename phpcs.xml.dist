<?xml version="1.0"?>
<ruleset name="NetivoActionLoggerMU">
	<description>WordPress VIP coding standards for netivo/action-logger-mu.</description>

	<file>src</file>
	<file>views</file>
	<file>netivo-action-logger-mu.php</file>

	<arg name="extensions" value="php,phtml"/>
	<arg value="sp"/>
	<arg name="colors"/>

	<config name="minimum_supported_wp_version" value="6.3"/>

	<rule ref="WordPressVIPMinimum"/>
	<rule ref="PHPCompatibility">
		<config name="testVersion" value="8.2-"/>
	</rule>
</ruleset>
